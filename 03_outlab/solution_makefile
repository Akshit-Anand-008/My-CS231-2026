TASKS = $(patsubst %/,%,$(wildcard */))
TASKS_VVP = $(patsubst %,%.vvp,$(TASKS))
TASKS_VCD = $(patsubst %,%.vcd,$(TASKS))

.PHONY: all clean default task5

default:
	@printf "Usage: make [task]\n"

$(TASKS): %: %.vcd
	@code $^

$(TASKS_VCD): %.vcd: %.vvp
	@vvp $^

TASK_DEPS_task1 =
TASK_DEPS_task2 =
TASK_DEPS_task3 = task1/crc_solution.v \
                  task2/encoder_solution.v task2/decoder_solution.v
TASK_DEPS_task4 =
TASK_DEPS_task5 = task1/crc_solution.v \
                  task2/encoder_solution.v task2/decoder_solution.v \
                  task3/rx_frame_solution.v task3/tx_frame_solution.v \
                  task4/switch_table.v

.SECONDEXPANSION:

get_v_files = $(filter-out $(patsubst %_solution.v,%.v,$(wildcard $1/*_solution.v)),$(wildcard $1/*.v))

$(TASKS_VVP): %.vvp: $$(call get_v_files,$$*) $$(TASK_DEPS_$$*)
	iverilog $^ -o $@

# -------------------------------------------------------
# Task-specific autograder
# -------------------------------------------------------

RED    = "\\033[31m"
GREEN  = "\\033[32m"
YELLOW = "\\033[33m"
RESET  = "\\033[0m"

task1.vcd: task1.vvp
	@vvp $^
	@python3 task1/crc_verifier.py --autograde

task3.vcd: task3.vvp
	@vvp $^ 2>&1 > task3_output.txt
	@cat task3_output.txt
	@python3 task3/verify_task3.py task3_output.txt


task5:
	@python3 task5/interactive_tester.py --setup-autograder --tb-file task5/tb_task5.v --input-file task5/input.txt
	@iverilog task5/switch_solution.v task5/tb_task5.v task1/crc_solution.v task2/encoder_solution.v task2/decoder_solution.v task3/rx_frame_solution.v task3/tx_frame_solution.v task4/switch_table_solution.v -o task5.vvp
	@vvp task5.vvp 2>&1 > task5_output.txt
	@echo 'Run `cat task5_output.txt` to view the output log'
	@python3 task5/interactive_tester.py --run-autograder --output-file task5_output.txt --input-file task5/input.txt

clean:
	@rm -fv $(TASKS_VVP) $(TASKS_VCD)

ifdef tasks

FOUND_FILES := $(shell find -L $(addprefix ./,$(tasks)) \
	\( -type d -iname '*solution*' -prune \) -o \
	\( -type f -o -type l \) \
	! \( -iname '*.tex' -o -iname '*.sty' \) \
	! -iname '*solution*' )

define SCRIPT_CONTENT
#!/usr/bin/env bash
set -e

RED=$$(printf '\033[31m')
GREEN=$$(printf '\033[32m')
NC=$$(printf '\033[0m')

read -rp "Enter Student Roll Number: " ROLL_NO
if [ -z "$$ROLL_NO" ]; then
    printf "$${RED}Error: Roll number cannot be empty.$${NC}\n" >&2
    exit 1
fi

VALID_PATTERN="^(210050102|23b0919|24b1017|24b1068|25b(090[1-9]|09[1-9][0-9]|10[0-9][0-9]|1100))$$"

if ! echo "$$ROLL_NO" | grep -qE "$$VALID_PATTERN" ; then
    printf "$${RED}Error: Invalid student ID. Please check the ID and try again.$${NC}\n" >&2
    exit 1
fi

mkdir -p "$$ROLL_NO"

echo "Packaging assignment files..."
FILES=($(FOUND_FILES))

for file in "$${FILES[@]}"; do
    if [ -e "$$file" ] || [ -L "$$file" ]; then
        mkdir -p "$$ROLL_NO/$$(dirname "$$file")"
        cp -RP "$$file" "$$ROLL_NO/$$file"
        printf "  $${GREEN}[+] Copied:$${NC} %s\n" "$$file"
    else
        printf "$${RED}Error: Required file or symlink missing: %s$${NC}\n" "$$file" >&2
        rm -rf "$$ROLL_NO"
        exit 1
    fi
done

tar -czf "$${ROLL_NO}.tar.gz" "$$ROLL_NO"
rm -rf "$$ROLL_NO"
printf "$${GREEN}Successfully created $${ROLL_NO}.tar.gz$${NC}\n"
endef

export SCRIPT_CONTENT

.PHONY: build_archive.sh

build_archive.sh:
	@printf '%s\n' "$$SCRIPT_CONTENT" > build_archive.sh
	@chmod +x build_archive.sh

endif